    <script>
      // デモ用: aria-busy と disabled をセットで付け外しするトグル（実運用の送信ボタン想定）
      document.querySelectorAll<HTMLButtonElement>('.js-busy-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          btn.setAttribute('aria-busy', 'true');
          btn.disabled = true;
          window.setTimeout(() => {
            btn.removeAttribute('aria-busy');
            btn.disabled = false;
          }, 2000);
        });
      });
    </script>
