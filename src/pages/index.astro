---
import Layout from '@/layouts/Layout.astro';
import Area from '@/components/features/Area.astro';
import AreaTime from '@/components/features/AreaTime.astro';
import Caution from '@/components/features/Caution.astro';
import Check from '@/components/features/Check.astro';
import Contact from '@/components/features/Contact.astro';
import Cva from '@/components/features/Cva.astro';
import Faq from '@/components/features/Faq.astro';
import Flow from '@/components/features/Flow.astro';
import Frequency from '@/components/features/Frequency.astro';
import Main from '@/components/features/Main.astro';
import OnTheDay from '@/components/features/OnTheDay.astro';
import Price from '@/components/features/Price.astro';
import Reason from '@/components/features/Reason.astro';
import Risk from '@/components/features/Risk.astro';
import Tel from '@/components/features/Tel.astro';
import Voice from '@/components/features/Voice.astro';

const url = '';
const title = 'ニチガスの排水管洗浄｜ニチガス（日本瓦斯株式会社）';
const description =
  '排水管の汚れ、放置していませんか？でんき・ガスだけでなく、ご自宅の排水管の高圧洗浄もニチガスにお任せください！キッチン、洗面台、お風呂、洗濯機の排水管から、屋外の汚水マスまでご対応いたします。';
const ogimage = '';
const current = 'top';
---

<Layout title={title} description={description} url={url} ogimage={ogimage} metakey="top" current={current}>
  {/* ページ個別の script は <Fragment slot="head"> で囲んでここに書く（</Layout> の後に書くと </html> の外に出る） */}
  <Main />
  <Check />
  <Cva variant="yellow" />
  <Reason />
  <Risk />
  <Area />
  <Cva variant="yellow" />
  <Price />
  <Cva variant="blue" />
  <Frequency />
  <OnTheDay />
  <Caution />
  <Flow />
  <Cva variant="blue" />
  <Voice />
  <AreaTime />
  <Faq />
  <Cva variant="blue" />
  <Contact />
  <Tel />
</Layout>

<style lang="scss">
  @use '@/styles/global' as *;
</style>
