---
import { Image, Picture } from 'astro:assets';
import Heading from '../base/Heading.astro';
import arrow from '@/images/icon_arrow_blue.png';
import img_risk_after from '@/images/img_risk_after.png';
import img_risk_before from '@/images/img_risk_before.png';

export interface Props {
  bg?: 'white' | 'blue';
}

const { bg = 'white' } = Astro.props;
---

<div class="BeforeAfterBlock" data-bg={bg} style={`--_arrow: url(${arrow.src})`}>
  <Heading lv="h3" tag="h3">洗浄前後の様子</Heading>
  <div>
    <div class="before">
      <span>洗浄前</span>
      <Image
        src={img_risk_before}
        alt="洗浄前の写真"
        width={424}
        densities={[1.5, 2]}
        format="avif"
        quality={50}
        loading="lazy"
      />
    </div>
    <div class="after">
      <span>洗浄後</span>
      <Image
        src={img_risk_after}
        alt="洗浄後の写真"
        width={424}
        densities={[1.5, 2]}
        format="avif"
        quality={50}
        loading="lazy"
      />
    </div>
  </div>
</div>

<style lang="scss">
  @use '@/styles/global' as *;
  .BeforeAfterBlock {
    padding: 48px 72px;
    margin-top: 56px;
    text-align: center;
    background-color: var(--color-white);
    border-radius: 40px;
    &[data-bg='blue'] {
      background: var(--color-bg-blue);
    }
    .h3 {
      font-size: rem(28);
      @include mq-down(md) {
        font-size: rem(22);
      }
    }
    @include mq-down(md) {
      padding: 24px;
      margin-top: 28px;
    }
    > div {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 88px;
      margin-top: 60px;
      @include mq-down(md) {
        grid-template-columns: auto;
        gap: 60px;
        margin-top: 40px;
      }
      > div {
        position: relative;
        span {
          position: absolute;
          top: -20px;
          left: 50%;
          padding: 4px 24px;
          font-size: rem(18);
          font-weight: bold;
          color: var(--color-white);
          border-radius: var(--rounded-full);
          transform: translateX(-50%);
          @include mq-down(md) {
            padding: 4px 16px;
            font-size: rem(15);
          }
        }
        &.before span {
          background-color: #6b788c;
        }
        &.after span {
          background-color: var(--color-primary);
        }
        + div {
          &::before {
            position: absolute;
            top: calc(50% + -10px);
            left: -60px;
            width: 32px;
            height: 32px;
            content: '';
            background-image: var(--_arrow);
            @include mq-down(md) {
              top: -56px;
              left: 50%;
              transform: rotate(90deg) translateY(50%);
            }
          }
        }
      }
    }
  }
</style>
