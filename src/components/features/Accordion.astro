---
export interface Props {
  open?: boolean;
  name?: string; // 同じname属性のアコーディオンは排他的になる
  class?: string;
}

const { open, name, class: className, ...rest } = Astro.props;
---

<details class:list={['Accordion', className]} open={open} name={name} {...rest}>
  <summary class="summary">
    <div>
      <span>Q</span>
      <slot name="summary" />
    </div>
  </summary>
  <div class="panel">
    <div class="content">
      <span>A</span>
      <slot />
    </div>
  </div>
</details>

<style lang="scss">
  @use '@/styles/global' as *;
  @layer components {
    .Accordion {
      --_arrow-size: 12px;
      .Accordion {
        margin-left: 20px;
      }
      > .summary {
        position: relative;
        display: block;
        padding: 20px;
        padding-right: calc(var(--_arrow-size) + var(--spacing-xs));
        cursor: pointer;
        background-color: var(--color-white);
        border-radius: 28px;
        @include mq-down(md) {
          padding: 16px;
          padding-right: 60px;
        }
        &::-webkit-details-marker {
          display: none;
        }
        > div {
          position: relative;
          display: flex;
          align-items: center;
          font-size: rem(18);
          font-weight: bold;
          @include mq-down(md) {
            font-size: rem(15);
          }
          &::after {
            position: absolute;
            top: 50%;
            right: -6px;
            z-index: 0;
            width: 32px;
            height: 32px;
            content: '';
            background-color: #e8f3ff;
            border-radius: var(--rounded-full);
            transform: translateY(-50%);
            @include mq-down(md) {
              right: -42px;
            }
          }
          > span {
            display: flex;
            flex-shrink: 0;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            margin-right: 20px;
            font-size: rem(20);
            font-weight: 900;
            color: var(--color-white);
            background-color: var(--color-primary);
            border-radius: var(--rounded-full);
          }
        }
        &::before,
        &::after {
          position: absolute;
          top: 50%;
          right: 28px;
          z-index: 1;
          display: block;
          width: var(--_arrow-size);
          height: 2px;
          margin-top: -1px;
          content: '';
          background: var(--color-primary);
        }
        &::after {
          rotate: -90deg;
          scale: 1 1;
          transition: scale var(--default-duration);
        }
      }
      > .panel {
        // details直下のタグにpaddingを設定すると挙動がおかしくなるので、ここには指定しない
        // > .content { /* 必要に応じてここに padding を指定 */ }
        > .content {
          display: flex;
          padding: 0 55px 20px 20px;
          font-size: rem(15);
          background-color: var(--color-white);
          border-radius: 0 0 28px 28px;
          transition: scale var(--default-duration);
          @include mq-down(md) {
            padding: 0 16px 16px;
            font-size: rem(14);
          }

          > span {
            display: flex;
            flex-shrink: 0;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            margin-right: 20px;
            font-size: rem(20);
            font-weight: 900;
            color: var(--color-white);
            background-color: var(--color-secondary);
            border-radius: var(--rounded-full);
          }
        }
      }
      // 閉じるアニメーション中も .content が見えているので、角丸は [open] が外れるまで維持する
      &[open] > .summary {
        border-radius: 28px 28px 0 0;
      }
      &[open]:not(.is-closing) {
        > .summary {
          transition: scale var(--default-duration);
          &::after {
            scale: 1 0;
          }
        }
      }
    }
  }
</style>

<script>
  import initializeDetailsAccordion, { type AccordionOptions } from '@/scripts/utils/initializeDetailsAccordion.ts';

  function initializeAccordions() {
    const detailsElements = document.querySelectorAll('details') as NodeListOf<HTMLDetailsElement>;

    if (detailsElements.length === 0) return;

    const options: AccordionOptions = {
      duration: 300,
      easing: 'ease-in-out',
    };

    detailsElements.forEach((details) => {
      initializeDetailsAccordion(details, options);
    });
  }

  // ViewTransition不使用時
  document.addEventListener('DOMContentLoaded', initializeAccordions);

  // ViewTransition使用時
  // document.addEventListener('astro:page-load', initializeAccordions);
</script>
