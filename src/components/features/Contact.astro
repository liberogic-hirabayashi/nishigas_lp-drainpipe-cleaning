---
import { Image, Picture } from 'astro:assets';
import Icon from '@/components/base/Icon.astro';
import Section from '@/components/base/Section.astro';
import SectionInner from '@/components/base/SectionInner.astro';
import SecTitle from '@/components/base/SecTitle.astro';
import Heading from '../base/Heading.astro';

// Googleフォームの「事前入力したURLを取得」で各設問の entry ID を確認して設定する
const GOOGLE_FORM_ACTION =
  'https://docs.google.com/forms/d/e/1FAIpQLScF3SVedSAvMzh_rviHUHWrQXvu0cIOFiQoT9RKkRfZyCQxhw/formResponse';
const ENTRY = {
  houseType: 'entry.492073079',
  name: 'entry.1299702797',
  kana: 'entry.1295024558',
  email: 'entry.1463796648',
  tel: 'entry.2044330490',
  zip: 'entry.682620208',
  address: 'entry.822879137',
  building: 'entry.1259925314',
  message: 'entry.1081246126',
};
---

<Section class="Contact" id="contact">
  <SectionInner width="narrow">
    <SecTitle tag="Contact">
      <Heading lv="h2" tag="h2"><span>お問い合わせ</span>フォーム</Heading>
      <p>ご登録後、ニチガスホームアシスト作業員よりご連絡させていただきます。</p>
    </SecTitle>
    <div class="Contact__formWrap">
      <form class="form" action={GOOGLE_FORM_ACTION} method="post" data-contact-form>
        <div class="form-area">
          <dl class="form-area__item">
            <dt>ご住宅タイプ<span class="icn-require">必須</span></dt>
            <dd>
              <ul class="form-radio-list">
                <li>
                  <label><input type="radio" name={ENTRY.houseType} value="戸建て" required />戸建て</label>
                </li>
                <li>
                  <label><input type="radio" name={ENTRY.houseType} value="集合住宅" />集合住宅</label>
                </li>
              </ul>
            </dd>
          </dl>
          <dl class="form-area__item">
            <dt>お名前<span class="icn-require">必須</span></dt>
            <dd>
              <input type="text" name={ENTRY.name} autocomplete="name" required placeholder="例）佐藤　太郎" />
            </dd>
          </dl>
          <dl class="form-area__item">
            <dt>カタカナ（フリガナ）<span class="icn-require">必須</span></dt>
            <dd>
              <input
                type="text"
                name={ENTRY.kana}
                required
                pattern="[ァ-ヶー\s]*[ァ-ヶー][ァ-ヶー\s]*"
                title="全角カタカナで入力してください"
                placeholder="例）サトウ　タロウ"
              />
            </dd>
          </dl>
          <dl class="form-area__item">
            <dt>メールアドレス<span class="icn-require">必須</span></dt>
            <dd>
              <input
                type="email"
                name={ENTRY.email}
                autocomplete="email"
                required
                pattern="[^@\s]+@[^@\s]+\.[^@\s]+"
                title="sample@example.com の形式で入力してください"
                placeholder="例）sample@example.com"
              />
            </dd>
          </dl>
          <dl class="form-area__item">
            <dt>電話番号（携帯）<span class="icn-require">必須</span></dt>
            <dd>
              <input type="tel" name={ENTRY.tel} autocomplete="tel" required placeholder="例）090-1234-5678" />
            </dd>
          </dl>
          <dl class="form-area__item">
            <dt>郵便番号<span class="icn-require">必須</span></dt>
            <dd>
              <input
                type="text"
                name={ENTRY.zip}
                inputmode="numeric"
                autocomplete="postal-code"
                required
                placeholder="例）123-4567"
              />
            </dd>
          </dl>
          <dl class="form-area__item">
            <dt>住所<span class="icn-require">必須</span></dt>
            <dd>
              <input
                type="text"
                name={ENTRY.address}
                autocomplete="street-address"
                required
                placeholder="例）東京都渋谷区〇〇1-2-3"
              />
            </dd>
          </dl>
          <dl class="form-area__item">
            <dt>アパート・マンション名<span class="icn-any">任意</span></dt>
            <dd>
              <input type="text" name={ENTRY.building} placeholder="例）〇〇マンション101号室" />
            </dd>
          </dl>
          <dl class="form-area__item">
            <dt>その他お問い合わせ内容<span class="icn-any">任意</span></dt>
            <dd>
              <textarea name={ENTRY.message} placeholder="ご質問・ご要望などございましたらご記入ください"></textarea>
            </dd>
          </dl>
          <div class="form-area__checkbox">
            <input type="checkbox" id="contact-agree" required data-contact-agree /><label for="contact-agree"
              ><a href="/privacy">個人情報の取り扱い</a>への同意（必須）</label
            >
          </div>
          <div class="form-area__btn-box">
            <button type="submit" data-contact-submit>
              <Icon name="mail" aria-hidden />
              この内容で送る
            </button>
          </div>
          <p class="form-error" role="alert" hidden data-contact-error>
            送信に失敗しました。時間をおいて再度お試しください。
          </p>
        </div>
      </form>
      <div class="thanks" tabindex="-1" hidden data-contact-thanks>
        <p class="thanks__title">お問い合わせありがとうございました。</p>
        <p>内容を確認のうえ、ニチガスホームアシスト作業員よりご連絡させていただきます。</p>
      </div>
    </div>
  </SectionInner>
</Section>

<style lang="scss">
  @use '@/styles/global' as *;
  .Contact {
    padding-bottom: 80px;
    margin-top: 40px;
    @include mq-down(md) {
      padding-bottom: 40px;
    }
    &::before {
      background-color: #ffe038;
    }
    &__formWrap {
      padding: 56px;
      margin-top: 48px;
      background-color: #e8f3ff;
      border-radius: 40px;
      @include mq-down(md) {
        padding: 28px;
        margin-top: 24px;
      }
      .form-area {
        &__item {
          display: grid;
          grid-template-columns: 300px 1fr;
          gap: 24px;
          @include mq-down(md) {
            grid-template-columns: auto;
            gap: 8px;
          }
          &:has(textarea) {
            align-items: flex-start;
            dt {
              @include mq-up(md) {
                margin-top: 18px;
              }
            }
          }
          dt {
            display: flex;
            gap: 10px;
            align-items: center;
            font-size: rem(16);
            font-weight: bold;
            @include mq-down(md) {
              font-size: rem(15);
            }
            span {
              display: inline-block;
              padding: 0 8px;
              font-size: rem(12);
              font-weight: bold;
              color: var(--color-white);
              border-radius: var(--rounded-full);
              &.icn-require {
                background-color: var(--color-secondary);
              }
              &.icn-any {
                background-color: #6b788c;
              }
            }
          }
          dd {
            input,
            textarea {
              width: 100%;
              padding: 16px 20px;
              background-color: var(--color-white);
              border: solid 2px #d6e3f2;
              border-radius: 16px;
              @include mq-down(md) {
                padding: 12px 14px;
              }
            }
            textarea {
              min-height: 160px;
            }
            .form-radio-list {
              display: flex;
              gap: 32px;
              input {
                width: auto;
                margin-right: 10px;
              }
            }
          }
          + .form-area__item {
            margin-top: 24px;
            @include mq-down(md) {
              margin-top: 12px;
            }
          }
        }
        &__checkbox {
          display: flex;
          align-items: center;
          justify-content: center;
          margin-top: 40px;
          font-weight: bold;
          input {
            width: 24px;
            height: 24px;
            margin-right: 10px;
          }
        }
        &__btn-box {
          display: flex;
          justify-content: center;
          margin-top: 24px;
          [type='submit'] {
            position: relative;
            display: flex;
            gap: var(--_gap);
            align-items: center;
            justify-content: center;
            width: 440px;
            padding: var(--_pad-y) var(--_pad-x);
            font-size: rem(22);
            font-weight: bold;
            line-height: 1.5;
            vertical-align: top;
            color: var(--_color);
            text-align: center;
            text-decoration: none;
            background-color: var(--color-secondary);
            border-radius: var(--rounded-full);
            box-shadow: 0 6px 0 0 #cc610d;
            transition: background var(--default-duration);
            --_icon-size: 1em;
            --_fit-space: calc(var(--_icon-size) / 2);
            --_pad-x: var(--spacing-sm);
            --_pad-y: 20px;
            --_gap: var(--spacing-xs);
            --_color: var(--color-white);
            @include mq-down(md) {
              font-size: rem(17);
            }
            &:disabled {
              opacity: 0.6;
            }
          }
        }
      }
      .form-error {
        margin-block-start: var(--spacing-sm);
        font-weight: bold;
        color: var(--color-attention);
        text-align: center;
      }
      .thanks {
        text-align: center;
        &__title {
          font-size: var(--text-xl);
          font-weight: bold;
        }
      }
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const agree = form.querySelector<HTMLInputElement>('[data-contact-agree]');
    const submit = form.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const error = form.querySelector<HTMLElement>('[data-contact-error]');
    const thanks = form.parentElement?.querySelector<HTMLElement>('[data-contact-thanks]');
    if (!agree || !submit) return;

    // JS無効時は送信できるよう、disabled はHTMLに書かずJSで付与する
    const syncDisabled = () => (submit.disabled = !agree.checked);
    syncDisabled();
    agree.addEventListener('change', syncDisabled);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submit.disabled = true;
      if (error) error.hidden = true;
      try {
        // Googleフォームは CORS 非対応のため no-cors で送信（レスポンスは読めないので通信失敗のみ検知できる）
        await fetch(form.action, {
          method: 'POST',
          mode: 'no-cors',
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        });
        form.hidden = true;
        if (thanks) {
          thanks.hidden = false;
          thanks.focus();
        }
      } catch {
        if (error) error.hidden = false;
        syncDisabled();
      }
    });
  });
</script>
