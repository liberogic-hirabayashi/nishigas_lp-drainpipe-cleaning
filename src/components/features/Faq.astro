---
import Section from '@/components/base/Section.astro';
import SectionInner from '@/components/base/SectionInner.astro';
import SecTitle from '@/components/base/SecTitle.astro';
import Accordion from '@/components/features/Accordion.astro';
import Heading from '../base/Heading.astro';
import { basicPackPrice } from '@/config/price';

const FaqList = [
  {
    Q: `料金は${basicPackPrice}円だけで済みますか？`,
    A: `一般戸建住宅で基本の作業範囲であれば${basicPackPrice}円（税込）です。トイレの屋内高圧洗浄、キッチン排水トラップがS管の場合、基本範囲を超える追加箇所がある場合は追加料金となります。事前調査のうえ正式にお見積もりいたします。`,
  },
  {
    Q: 'どのくらいの頻度で洗浄すればよいですか？',
    A: '洗浄の目安は3〜5年です。今回の清掃で2〜3年は掃除いらずの状態を保てます。（※汚れの状態・配管経路・使用状況により異なります）。',
  },
  {
    Q: 'マンションなどの集合住宅でも依頼できますか？',
    A: 'ご相談いただけます。集合住宅の場合は別途お見積もりとなります。',
  },
  {
    Q: 'トイレも洗浄してもらえますか？',
    A: 'トイレの屋内高圧洗浄は追加オプションとなり、便器内から高圧洗浄を行うことはできません。トイレを脱着せずに行う場合は薬剤洗浄・空気圧縮ポンプによる作業となります。',
  },
  { Q: '作業当日は立ち会いが必要ですか？', A: 'お立ち会いが必要となります。' },
  { Q: '作業時間はどのくらいかかりますか？', A: '作業時間は約90分です。' },
  {
    Q: 'ニチガスのガスを契約していなくても依頼できますか？',
    A: 'ご契約されていないお客さまでもご依頼いただけます。',
  },
  {
    Q: 'すでに詰まっている場合も対応できますか？',
    A: '対応可能です。詰まりの状況を確認したうえで、適切な作業方法をご案内いたします。',
  },
  { Q: '支払い方法は選べますか？', A: 'クレジットカードまたは銀行振込からお選びいただけます。' },
  { Q: '見積り後に断ることはできますか？', A: 'キャンセル可能です。' },
  {
    Q: '作業中、水道やトイレは使えますか？',
    A: '洗浄中の場所とは別の蛇口であれば、比較的安心して使えますが、極力控えてください。',
  },
  {
    Q: '作業車の駐車スペースは必要ですか？',
    A: '駐車スペースの確保をお願いいたします。スペースがない場合は、事前にお伝えください。',
  },
  {
    Q: '汚水枡（外枡）が見当たらない・埋まっている場合はどうなりますか？',
    A: '作業当日に状況を確認いたします。汚水枡が確認できない場合や、土・コンクリートなどで埋まっている場合は、高圧洗浄作業ができないことがあります。',
  },
  { Q: '賃貸住宅でも依頼できますか？', A: '事前に必ず管理会社や大家さんへご連絡・ご相談をお願いいたします。' },
  {
    Q: '悪臭や害虫が出ている場合も、高圧洗浄で改善しますか？',
    A: '高圧洗浄で改善する可能性が非常に高いです。原因によっては高圧洗浄だけでは解決しないケースもあります。',
  },
  {
    Q: '戸建てなので洗浄は不要と聞きましたが、本当に必要ですか？',
    A: '戸建てであっても、油汚れや髪の毛が少しずつ溜まる可能性があるため、完全に洗浄が不要というわけではございません。',
  },
];
---

<Section class="Faq" bg="blue">
  <SectionInner width="narrow">
    <SecTitle tag="Faq">
      <Heading lv="h2" tag="h2"><span>よくある質問</span></Heading>
    </SecTitle>
    {
      FaqList.map((faq) => (
        <Accordion>
          <Fragment slot="summary">{faq.Q}</Fragment>
          {faq.A}
        </Accordion>
      ))
    }
  </SectionInner>
</Section>

<style lang="scss">
  @use '@/styles/global' as *;
  .Faq {
    padding-bottom: 80px;
    margin-top: 40px;
    @include mq-down(md) {
      padding-bottom: 40px;
    }
    &::before {
      background-color: var(--color-white);
    }
    :global(.SecTitle__tag) {
      background-color: var(--color-white);
    }
    :global(.Accordion + .Accordion) {
      margin-top: 14px;
    }
  }
</style>
