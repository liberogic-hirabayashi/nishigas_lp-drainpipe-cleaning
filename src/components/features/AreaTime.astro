---
import { Image, Picture } from 'astro:assets';
import PictureImage from '@/components/base/PictureImage.astro';
import Section from '@/components/base/Section.astro';
import SectionInner from '@/components/base/SectionInner.astro';
import SecTitle from '@/components/base/SecTitle.astro';
import Heading from '../base/Heading.astro';
import map from '@/images/img_map.png';
import map_sp from '@/images/img_map_sp.png';
---

<Section class="AreaTime">
  <SectionInner>
    <SecTitle tag="AREA & TIME">
      <Heading lv="h2" tag="h2"><span>対応エリア</span>・受付時間</Heading>
    </SecTitle>
    <div class="AreaTime__grid">
      <div class="img">
        <PictureImage
          src={map}
          spSrc={map_sp}
          alt=""
          width={516}
          spWidth={335}
          spHeight={376}
          densities={[1.5, 2]}
          format="avif"
          quality={50}
          loading="lazy"
        />
      </div>
      <div class="box">
        <Heading lv="h3" tag="h3">受付時間</Heading>
        <p>
          平日9:00〜17:00<br />
          ※お問い合わせフォームは24時間受付です
        </p>
      </div>
      <div class="box">
        <Heading lv="h3" tag="h3">対応エリア</Heading>
        <p>
          １都９県<br />
          （東京・埼玉・千葉・茨城・栃木・群馬・神奈川・静岡・山梨・長野）<br />※地域によっては対応できない場合あり
        </p>
      </div>
    </div>
  </SectionInner>
</Section>

<style lang="scss">
  @use '@/styles/global' as *;
  .AreaTime {
    padding-bottom: 80px;
    margin-top: 40px;
    @include mq-down(md) {
      padding-bottom: 40px;
    }
    &::before {
      background-color: var(--color-bg-orange);
    }
    &__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 48px;
      align-items: center;
      @include mq-down(md) {
        grid-template-columns: auto;
      }
      .img {
        @include mq-up(md) {
          grid-row: 1/3;
          grid-column: 1/2;
        }
      }
      .box {
        padding: 28px;
        background-color: #fff2c7;
        border-radius: 28px;
        @include mq-down(md) {
          padding: 16px;
        }
        .h3 {
          font-size: rem(22);
          font-weight: bold;
          color: var(--color-primary);
          @include mq-down(md) {
            font-size: rem(17);
          }
        }
        p {
          font-size: rem(15);
          @include mq-down(md) {
            font-size: rem(14);
          }
        }
        &:first-child {
          @include mq-up(md) {
            grid-row: 1/2;
            grid-column: 2/3;
          }
        }
        &:last-child {
          @include mq-up(md) {
            grid-row: 2/3;
            grid-column: 2/3;
          }
          background-color: var(--color-bg-blue);
        }
      }
    }
  }
</style>
