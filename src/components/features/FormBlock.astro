---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  required?: boolean;
  label: string;
  labelFor?: string;
  labelId?: string;
  labelDescription?: string;
  labelBadge?: boolean;
  labelHidden?: boolean;
  description?: string;
  descriptionId?: string;
  errorId?: string;
}

const {
  required,
  label,
  labelFor,
  labelId,
  labelDescription,
  labelBadge = true,
  labelHidden,
  description,
  descriptionId,
  errorId,
  class: className,
  ...rest
} = Astro.props;
---

<div class:list={['FormBlock', className]} {...rest}>
  <div class:list={['label', { 'sr-only': labelHidden }]}>
    {
      labelId ? (
        <div id={labelId}>
          {labelBadge && (required ? <span class="-required">必須</span> : <span class="-optional">任意</span>)}
          {label}
        </div>
      ) : (
        <label for={labelFor}>
          {labelBadge && (required ? <span class="-required">必須</span> : <span class="-optional">任意</span>)}
          {label}
        </label>
      )
    }
    {labelDescription && <p class="labelDescription">{labelDescription}</p>}
  </div>
  <div class="content">
    <div class="inputGroup">
      <slot />
    </div>
    {
      errorId && (
        <div class="error-message" id={errorId} role="alert">
          <slot name="error" />
        </div>
      )
    }
    {
      description && (
        <div id={descriptionId} class="description">
          {description}
        </div>
      )
    }
  </div>
</div>

<style lang="scss">
  @use '@/styles/global' as *;
  @layer components {
    .FormBlock {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
      @include mq-down(md) {
        grid-template-columns: 1fr;
        gap: 8px;
      }
      + .FormBlock {
        padding: 32px 0 0;
      }
      .label {
        margin-bottom: 8px;
        label {
          display: flex;
          align-items: center;
        }
        .-required,
        .-optional {
          padding: 4px;
          margin-right: 8px;
          font-size: var(--text-xs);
          font-weight: bold;
          line-height: 1;
          border-radius: var(--rounded-sm);
        }
        .-required {
          color: var(--color-white);
          background: var(--color-primary);
        }
        .-optional {
          color: var(--color-text);
          background: var(--color-secondary);
        }
      }
      .labelDescription {
        font-size: var(--text-sm);
        line-height: 1.5;
        color: var(--color-muted);
      }
      .content {
        display: flex;
        flex-flow: column;
        .error-message {
          margin-top: 8px;
          font-size: var(--text-sm);
          color: var(--color-attention);
        }
        .description {
          margin-top: 8px;
          font-size: var(--text-sm);
          color: var(--color-muted);
        }
        .error-message + .description {
          margin-top: 0;
        }
        .inputGroup {
          display: flex;
          gap: 24px;
          > :global([role='group']) {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 40px;
          }
        }
        :global(.message) {
          font-size: var(--text-sm);
        }
      }
    }
  }
</style>
