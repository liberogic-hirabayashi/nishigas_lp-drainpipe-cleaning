---
import { Image, Picture } from 'astro:assets';
import Button from '@/components/base/Button.astro';
import ButtonWrap from '@/components/base/ButtonWrap.astro';
import Icon from '@/components/base/Icon.astro';
import Section from '@/components/base/Section.astro';
import SectionInner from '@/components/base/SectionInner.astro';
import Annotation from '../base/Annotation.astro';
import Heading from '../base/Heading.astro';
import { basicPackPrice } from '@/config/price';
import Title from '@/images/haisui_title.png';

import IconMovie from '@/images/icon_movie.svg';
import SpImage01 from '@/images/img_sp01.png';
import SpImage02 from '@/images/img_sp02.png';
---

<Section class="Main" tag="div">
  <div class="Main__wrapper">
    <SectionInner>
      <div class="Main__contents">
        <div class="Main__copy"><span>屋内からも屋外からも、まるごと高圧洗浄</span></div>
        <Heading lv="h1" tag="h1">
          <Image
            src={Title}
            alt="排水管高圧洗浄"
            width={720}
            densities={[1.5, 2]}
            format="avif"
            quality={50}
            loading="eager"
            fetchpriority="high"
          />
        </Heading>
        <div class="Main__lead">
          キッチン・洗面台・浴室・洗濯排水の屋内4箇所と、<br />
          屋外の外枡10枡まで。
        </div>
        <div class="Main__spImage">
          <Image src={SpImage01} alt="" width={160} densities={[1.5, 2]} format="avif" quality={50} loading="lazy" />
          <Image src={SpImage02} alt="" width={160} densities={[1.5, 2]} format="avif" quality={50} loading="lazy" />
        </div>
        <div class="Main__features">
          <div>
            基本パック
            <span class="num">{basicPackPrice}</span>円（税込）
          </div>
          <div>
            電話ですぐに
            <span class="">お見積もり</span>
          </div>
          <div>
            累計
            <span class="num">2,000</span>件以上
            <Annotation mark="※">2026年9月末時点</Annotation>
          </div>
        </div>
        <p>施工は安心のニチガスホームアシスト株式会社が行います</p>
        <ButtonWrap justify="start">
          <Button href="#tel">
            <span class="speechbubble">平日9:00〜17:00</span>
            <Fragment slot="icon-left">
              <Icon name="tel" aria-hidden />
            </Fragment>
            <span>＼ 電話ですぐにお見積もり ／</span>
            お電話で相談する
          </Button>
          <Button href="#contact" variant="secondary">
            <span class="speechbubble">24時間受付</span>
            <Fragment slot="icon-left">
              <Icon name="mail" aria-hidden />
            </Fragment>
            <span>＼ 見積もり・キャンセル料無料 ／</span>お問い合わせフォーム
          </Button>
        </ButtonWrap>
        <ButtonWrap justify="start">
          <a href="/" class="Button -outline">
            <Fragment slot="icon-left">
              <IconMovie aria-hidden />
            </Fragment>
            <span>動画で確認する</span>
          </a>
        </ButtonWrap>
      </div>
    </SectionInner>
  </div>
</Section>

<style lang="scss">
  @use '@/styles/global' as *;
  .Main {
    padding-block: 0;
    overflow: hidden;
    background: linear-gradient(180deg, #dbedff 0%, var(--color-bg-orange) 100%);

    $this: &;
    &::before,
    &::after {
      position: absolute;
      z-index: 1;
      content: '';
      background-repeat: no-repeat;
      background-size: contain;
      @include mq-down(md) {
        display: none;
      }
    }
    &::before {
      top: 80px;
      left: -16px;
      width: vw(340, 1280);
      min-width: 240px;
      max-width: 440px;
      height: auto;
      aspect-ratio: 636 / 810;
      background-image: url('@/images/main01.png');
    }
    &::after {
      top: 133px;
      right: -120px;
      width: vw(462, 1280);
      min-width: 362px;
      max-width: 562px;
      height: auto;
      aspect-ratio: 1020 / 1176;
      background-image: url('@/images/main02.png');
    }

    &__wrapper {
      max-width: 1500px;
      padding-block: 80px;
      margin-inline: auto;
      background-image: url('@/images/bg.png');
      background-repeat: no-repeat;
      background-position: 50% -80px;
      background-size: 1480px 840px;
      @include mq-down(md) {
        padding: 24px 0 40px;
        // 画像の下端が線に見えないよう、画像の下30%を Check の背景色へなじませる（233.2vw = bg_sp.png の縦横比 1749 / 750）
        background-image: linear-gradient(transparent 70%, var(--color-bg-orange)), url('@/images/bg_sp.png');
        background-position: 50% 0;
        background-size:
          100% 233.2vw,
          100% auto;
      }
    }
    &__contents {
      position: relative;
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: center;

      .h1 {
        margin-block: 16px;
        line-height: 1;
        @include mq-down(md) {
          margin-block: 12px;
        }
      }
      #{$this}__copy {
        span {
          display: inline-block;
          padding: 8px 20px;
          font-size: rem(18);
          font-weight: bold;
          color: var(--color-primary);
          background-color: var(--color-white);
          border: solid 2px var(--color-primary);
          border-radius: var(--rounded-full);
          @include mq-down(md) {
            padding-inline: 16px;
            font-size: rem(15);
          }
        }
      }
      #{$this}__lead {
        font-size: rem(18);
        font-weight: bold;
        text-align: center;
        @include mq-down(md) {
          font-size: rem(13);
        }
      }
      #{$this}__features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        width: 524px;
        margin: 16px auto;
        @include mq-down(md) {
          grid-template-columns: repeat(3, auto);
          gap: 0;
          justify-content: center;
          width: 100%;
        }
        > div {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          width: 164px;
          height: 164px;
          font-size: rem(14);
          font-weight: bold;
          background-image: url('@/images/img_deco.png');
          background-size: 100% 100%;
          @include mq-down(md) {
            width: vw(109, 375);
            height: vw(109, 375);
            font-size: rem(10);
          }
          > span {
            display: block;
            font-size: rem(26);
            font-weight: 900;
            line-height: 1;
            @include mq-down(md) {
              font-size: rem(17);
            }
            &.num {
              font-size: rem(34);
              @include mq-down(md) {
                font-size: rem(22);
              }
            }
          }
          :global(.Annotation) {
            font-size: rem(10) !important;
            font-weight: normal !important;
            color: #213354;
            @include mq-down(md) {
              font-size: rem(7) !important;
            }
          }
        }
      }
      #{$this}__spImage {
        display: none;
        @include mq-down(md) {
          display: flex;
          gap: 12px;
          align-items: center;
          justify-content: center;
          margin-top: 16px;
        }
      }
      > p {
        display: flex;
        align-items: center;
        font-size: rem(14);
        @include mq-down(md) {
          font-size: rem(12);
          letter-spacing: -0.01rem;
        }
        &::before {
          display: block;
          width: 10px;
          height: 10px;
          margin-right: 7px;
          content: '';
          background-color: var(--color-yellow);
          border-radius: var(--rounded-full);
        }
      }
      :global(.ButtonWrap) {
        margin-top: 48px;
        @include mq-down(md) {
          display: flex;
          flex-direction: column;
          gap: 42px;
        }
        + .ButtonWrap {
          margin-top: 24px;
        }
      }
      :global(.Button) {
        --_shadow-color: #053385;
        --_main-color: var(--color-primary);
        grid-template-columns: auto auto var(--_icon-size);
        min-width: 296px;
        padding-block: 12px;
        box-shadow: 0 6px 0 0 var(--_shadow-color);
        @include mq-down(md) {
          grid-template-columns: var(--_icon-size) 1fr var(--_icon-size);
        }
        span:not(.speechbubble) {
          display: flex;
          flex-direction: column;
          font-size: rem(12);
          color: #ffe566;
          text-shadow: none;
        }
        .speechbubble {
          position: absolute;
          top: -20px;
          left: 50%;
          width: auto;
          padding: 1px 10px;
          font-size: rem(13);
          color: var(--_main-color);
          white-space: nowrap;
          text-shadow: none;
          background-color: var(--color-white);
          border: solid 2px var(--_main-color);
          border-radius: var(--rounded-full);
          transform: translateX(-50%);
          &::before {
            position: absolute;
            bottom: -8px;
            left: 50%;
            width: 10px;
            height: 8px;
            content: '';
            background-color: var(--_main-color);
            clip-path: polygon(0 0, 100% 0%, 50% 100%);
            transform: translateX(-50%);
          }
        }
        // svgには疑似要素が付かないため outline で外側に円枠を描き、その分を margin で確保する（9px + 1px = 直径40px）。
        // border-radius は outline を丸めるためのもの。svgは既定で overflow: hidden なので visible にしないとアイコンの角が切れる
        :global(.Icon) {
          width: 20px;
          height: 20px;
          margin: 10px;
          overflow: visible;
          outline: solid 1px var(--color-white);
          outline-offset: 9px;
          border-radius: var(--rounded-full);
        }
        &[data-variant='secondary'] {
          --_main-color: var(--color-secondary);
          --_shadow-color: #a82908;
        }
        &.-outline {
          display: flex;
          gap: 8px;
          align-items: center;
          min-width: auto;
          padding: 11px 20px;
          text-decoration: none;
          background-color: var(--color-white);
          border: solid 1px #21335426;
          border-radius: var(--rounded-full);
          box-shadow: none;
          @include hover {
            opacity: 0.7;
          }
          span {
            font-size: rem(14);
            font-weight: bold;
            color: #213354;
          }
        }
      }
    }
  }
</style>
