---
import { Image, Picture } from 'astro:assets';
import Button from '@/components/base/Button.astro';
import ButtonWrap from '@/components/base/ButtonWrap.astro';
import Icon from '@/components/base/Icon.astro';
import Section from '@/components/base/Section.astro';
import SectionInner from '@/components/base/SectionInner.astro';
import headline from '@/images/headline.png';
---

<Section class="Cva">
  <SectionInner>
    <div class="Cva__wrap">
      <div class="speechBubble">
        <span>お見積り・キャンセル料 すべて無料</span>
      </div>
      <div class="headline">
        <Image
          src={headline}
          alt="排水管の詰まり・ニオイが気になったら お早めにご相談ください"
          width={784}
          densities={[1.5, 2]}
          format="avif"
          quality={50}
          loading="lazy"
        />
      </div>
      <div class="text">
        基本パック<span>38,500円（税込）</span>／電話ですぐにお見積もり。お見積り後の追加費用はいただきません
      </div>
      <ButtonWrap justify="start">
        <Button href="#" size="lg">
          <Fragment slot="icon-left">
            <Icon name="copy" aria-hidden />
          </Fragment><span> お電話で相談する </span>
        </Button>
        <Button href="#" variant="secondary" size="lg">
          <Fragment slot="icon-left">
            <Icon name="copy" aria-hidden />
          </Fragment>
          お問い合わせフォーム
        </Button>
      </ButtonWrap>
    </div>
  </SectionInner>
</Section>

<style lang="scss">
  @use '@/styles/global' as *;
  .Cva {
    position: relative;
    padding-bottom: 80px;
    margin-top: 40px;
    background-color: #ffe038;
    background-image: url('/src/images/bg_cva.png');
    background-size: cover;
    :global(.SectionInner) {
      position: relative;
      overflow-x: hidden;
    }
    &::before {
      position: absolute;
      top: -40px;
      left: 0;
      width: 100%;
      height: 40px;
      content: '';
      background-color: #fff8e5;
      background-image: url('/src/images/cva_line.png');
      background-size: cover;
    }
    &::after {
      position: absolute;
      right: 0;
      bottom: 40px;
      width: 288px;
      height: 211px;
      content: '';
      background-image: url('/src/images/cva_illust.png');
      background-size: contain;
    }

    &__wrap {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      &::before,
      &::after {
        position: absolute;
        z-index: -1;
        content: '';
        background-size: cover;
      }
      &::before {
        top: 0;
        left: 0;
        width: 152px;
        height: 232px;
        background-image: url('/src/images/cva_deco_left.png');
      }
      &::after {
        top: 0;
        right: -40px;
        width: 150px;
        height: 250px;
        background-image: url('/src/images/cva_deco_right.png');
      }

      .speechBubble {
        position: relative;
        padding: 10px 30px;
        margin-bottom: 30;
        font-size: rem(20);
        font-weight: 900;
        color: var(--color-white);
        background-color: var(--color-attention);
        border-radius: var(--rounded-full);
        &::after {
          position: absolute;
          top: 99%;
          left: 50%;
          content: '';
          border: 8px solid transparent;
          border-top: 8px solid var(--color-attention);
          transform: translateX(-50%);
        }
      }
      .headline {
        margin-bottom: 26px;
      }
      .text {
        position: relative;
        padding: 6px 28px;
        font-weight: bold;
        background-color: var(--color-white);
        border-radius: var(--rounded-full);
        span {
          font-size: rem(20);
          color: var(--color-attention);
        }
      }
      :global(.ButtonWrap) {
        margin-top: 32px;
      }
    }
  }
</style>
