---
import { Image, Picture } from 'astro:assets';
import Button from '@/components/base/Button.astro';
import ButtonWrap from '@/components/base/ButtonWrap.astro';
import Icon from '@/components/base/Icon.astro';
import PictureImage from '@/components/base/PictureImage.astro';
import Section from '@/components/base/Section.astro';
import SectionInner from '@/components/base/SectionInner.astro';
import { basicPackPrice } from '@/config/price';
import illust from '@/images/cva_illust.png';
import headline from '@/images/headline.png';
import headlineSp from '@/images/headline_sp.png';

export interface Props {
  variant?: 'white' | 'blue' | 'yellow';
}

const { variant = '' } = Astro.props;

// CSS の background-image でも同じ画像を使っている。.src を参照しないと <Image> の最適化後に元画像がビルド出力から削除されるため、明示的に参照して残す
void illust.src;
---

<Section class="Cva" data-variant={variant}>
  <SectionInner>
    <div class="Cva__wrap">
      <div class="speechBubble">
        <span>お見積もり・キャンセル料 すべて無料</span>
      </div>
      <div class="headline">
        <PictureImage
          src={headline}
          spSrc={headlineSp}
          alt="排水管の詰まり・ニオイが気になったら お早めにご相談ください"
          width={784}
          spWidth={335}
          densities={[1.5, 2]}
          format="avif"
          quality={50}
          loading="lazy"
        />
      </div>
      <div class="text">
        <Image src={illust} alt="" width={87} densities={[1.5, 2]} format="avif" quality={50} loading="lazy" />
        <p>
          基本パック<span>{basicPackPrice}円<span>（税込）</span></span
          >電話ですぐにお見積もり。お見積もり後の追加費用はいただきません
        </p>
      </div>
      <ButtonWrap justify="start">
        <Button href="#tel">
          <span class="speechbubble">平日9:00〜17:00</span>
          <Fragment slot="icon-left">
            <Icon name="tel" aria-hidden />
          </Fragment>
          お電話で相談する
        </Button>
        <Button href="#contact" variant="secondary">
          <span class="speechbubble">24時間受付</span>
          <Fragment slot="icon-left">
            <Icon name="mail" aria-hidden />
          </Fragment>
          お問い合わせフォーム
        </Button>
      </ButtonWrap>
      <div class="Cva__link">
        <a href="#price">料金の詳細はこちら ›</a>
      </div>
    </div>
  </SectionInner>
</Section>

<style lang="scss">
  @use '@/styles/global' as *;
  .Cva {
    position: relative;
    padding-top: 110px;
    padding-bottom: 80px;
    margin-top: 40px;
    background-color: var(--color-bg-yellow);
    background-image: url('@/images/bg_cva.png');
    background-size: cover;
    @include mq-down(md) {
      padding-top: 45px;
      padding-bottom: 40px;
    }
    :global(.SectionInner) {
      position: relative;
      // hidden だと overflow-y が auto に変わり、Buttonの下方向のbox-shadowが切れるため clip を使う
      overflow-x: clip;
    }
    &::before {
      position: absolute;
      top: -40px;
      left: 0;
      width: 100%;
      height: 40px;
      content: '';
      background-image: url('@/images/cva_line.png');
      background-size: cover;
    }
    &::after {
      position: absolute;
      right: 0;
      bottom: 40px;
      width: 288px;
      height: 211px;
      content: '';
      background-image: url('@/images/cva_illust.png');
      background-size: contain;
      @include mq-down(lg) {
        position: absolute;
        top: 0;
        width: 100%;
        height: 100%;
        content: '';
        background-image: url('@/images/cva_deco_sp.png');
        background-size: cover;
      }
    }

    &__wrap {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      &::before,
      &::after {
        position: absolute;
        z-index: -1;
        content: '';
        background-size: cover;
        @include mq-down(md) {
          display: none;
        }
      }
      &::before {
        top: 0;
        left: 0;
        width: 152px;
        height: 232px;
        background-image: url('@/images/cva_deco_left.png');
      }
      &::after {
        top: 0;
        right: -40px;
        width: 150px;
        height: 250px;
        background-image: url('@/images/cva_deco_right.png');
      }

      .speechBubble {
        position: relative;
        padding: 10px 30px;
        margin-bottom: 30px;
        font-size: rem(20);
        font-weight: 900;
        color: var(--color-white);
        background-color: var(--color-attention);
        border-radius: var(--rounded-full);
        @include mq-down(md) {
          padding: 5px 16px;
          margin-bottom: 16px;
          font-size: rem(17);
        }
        &::after {
          position: absolute;
          top: 99%;
          left: 50%;
          content: '';
          border: 8px solid transparent;
          border-top: 8px solid var(--color-attention);
          transform: translateX(-50%);
        }
      }
      .headline {
        margin-bottom: 26px;
        @include mq-down(md) {
          margin-bottom: 8px;
        }
      }
      .text {
        position: relative;
        padding: 6px 28px;
        font-weight: bold;
        background-color: var(--color-white);
        border-radius: var(--rounded-full);
        @include mq-down(lg) {
          display: flex;
          gap: 16px;
          align-items: center;
          padding: 10px 22px;
          font-size: rem(15);
          line-height: 1.5;
          border-radius: var(--rounded-md);
        }
        img {
          display: none;
          @include mq-down(lg) {
            display: block;
            flex-shrink: 0;
          }
        }

        p > span {
          font-size: rem(20);
          color: var(--color-attention);
          @include mq-down(md) {
            font-size: rem(17);
            line-height: 1.5;
            letter-spacing: -0.04rem;
            > span {
              font-size: rem(10);
            }
          }
        }
      }
      :global(.ButtonWrap) {
        margin-top: 52px;
        @include mq-down(lg) {
          gap: var(--spacing-xl);
          margin-top: 40px;
        }
      }
      :global(.Button) {
        --_icon-size: 22px;
        --_shadow-color: #053385;
        --_main-color: var(--color-primary);
        // 既定の 1fr だと min-width / width: 100% で文字列が伸び、左右アイコンが両端に離れるため中央にまとめる
        grid-template-columns: var(--_icon-size) auto var(--_icon-size);
        min-width: 420px;
        padding: 24px 20px;
        border: solid 2px var(--_shadow-color);
        box-shadow: 0 6px 0 0 var(--_shadow-color);
        @include mq-down(lg) {
          width: 100%;
          min-width: 100%;
          padding: 16px 20px;
        }
        :global(> span) {
          font-size: rem(28) !important;
          @include mq-down(lg) {
            font-size: rem(22) !important;
          }
        }

        .speechbubble {
          position: absolute;
          top: -20px;
          left: 50%;
          width: auto;
          padding: 2px 20px;
          font-size: rem(15);
          color: var(--_main-color);
          white-space: nowrap;
          text-shadow: none;
          background-color: var(--color-white);
          border: solid 2.5px var(--_main-color);
          border-radius: var(--rounded-full);
          transform: translateX(-50%);
          &::before {
            position: absolute;
            bottom: -8px;
            left: 50%;
            width: 10px;
            height: 8px;
            content: '';
            background-color: var(--_main-color);
            clip-path: polygon(0 0, 100% 0%, 50% 100%);
            transform: translateX(-50%);
          }
        }
        &[data-variant='secondary'] {
          --_main-color: var(--color-secondary);
          --_shadow-color: #a82908;
        }
      }
      .Cva__link {
        margin-top: 26px;
        text-align: center;
        @include mq-down(lg) {
          margin-top: 16px;
        }
        a {
          font-weight: bold;
          color: var(--color-attention);
        }
      }
    }
    &[data-variant='yellow'] {
      &::before {
        background-color: var(--color-bg-orange);
      }
    }
    &[data-variant='blue'] {
      &::before {
        background-color: var(--color-bg-blue);
      }
    }
    &[data-variant='white'] {
      &::before {
        background-color: var(--color-white);
      }
    }
  }
</style>
