---
import { Image, Picture } from 'astro:assets';
import Section from '@/components/base/Section.astro';
import SectionInner from '@/components/base/SectionInner.astro';
import SecTitle from '@/components/base/SecTitle.astro';
import Heading from '../base/Heading.astro';
import img_frequency01 from '@/images/img_frequency01.png';
import img_frequency02 from '@/images/img_frequency02.png';
---

<Section class="Frequency">
  <SectionInner>
    <SecTitle tag="Frequency">
      <Heading lv="h2" tag="h2">洗浄の<span>頻度の目安</span></Heading>
    </SecTitle>

    <div class="Frequency__wrap">
      <div class="item">
        <div class="heading">
          <span>戸建てにお住まいの場合</span>
          <div><span>3〜5年</span>に1回</div>
        </div>
        <div class="img">
          <Image
            src={img_frequency01}
            alt=""
            width={452}
            densities={[1.5, 2]}
            format="avif"
            quality={50}
            loading="lazy"
          />
        </div>
        <p>
          キッチンからの油汚れや浴室の髪の毛などが徐々に蓄積するため、3〜5年で一度リセットするのが最適です。築10年以上経過している場合や家族数が多いご家庭では、1〜2年ごとの洗浄が推奨
        </p>
      </div>
      <div class="item">
        <div class="heading">
          <span>集合住宅にお住まいの場合</span>
          <div><span>1〜2年</span>に1回</div>
        </div>
        <div class="img">
          <Image
            src={img_frequency02}
            alt=""
            width={452}
            densities={[1.5, 2]}
            format="avif"
            quality={50}
            loading="lazy"
          />
        </div>
        <p>
          多くの世帯で縦の配管などを共有しているため、管理組合や大家さんの主導で、年に1回定期清掃として全戸一斉に行われるのが一般的となります
        </p>
      </div>
    </div>
  </SectionInner>
</Section>

<style lang="scss">
  @use '@/styles/global' as *;
  .Frequency {
    padding-bottom: 80px;
    margin-top: 40px;
    &::before {
      background-color: #ffe038;
    }
    &__wrap {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
      @include mq-down(md) {
        grid-template-columns: auto;
        gap: 16px;
      }
      .item {
        --bg_color: #e8f3ff;
        padding: 36px;
        background-color: var(--bg_color);
        border-radius: 40px;
        @include mq-down(md) {
          padding: 18px;
        }

        &:last-child {
          --bg_color: #fff8e5;
        }
        .heading {
          font-weight: bold;
          text-align: center;
          > span {
            font-size: rem(20);
            @include mq-down(md) {
              font-size: rem(17);
            }
          }
          > div {
            font-size: rem(44);
            font-weight: 900;
            @include mq-down(md) {
              font-size: rem(27);
            }
            > span {
              color: var(--color-primary);
            }
          }
        }
        .img {
          margin-block: 20px;
        }
        p {
          font-size: rem(15);
          @include mq-down(md) {
            font-size: rem(14);
          }
        }
      }
    }
  }
</style>
