---
import { Image } from 'astro:assets';
import Button from '@/components/base/Button.astro';
import ButtonWrap from '@/components/base/ButtonWrap.astro';
import Icon from '@/components/base/Icon.astro';
import IconButton from '@/components/base/IconButton.astro';
import NavigationMenu from '@/components/features/NavigationMenu.astro';
import Logo from '@/images/logo.svg';

export interface Props {
  current?: string;
  sticky?: boolean;
}

const { current, sticky = false } = Astro.props;
---

<header class="GlobalHeader" data-sticky={sticky}>
  <a href="/" class="logo">
    <Logo />
  </a>
  <NavigationMenu aria-label="メインメニュー">
    <p class="hide-down-md">【受付時間】平日9:00〜17:00（土日祝休）</p>
    <ButtonWrap justify="start" class="hide-down-md">
      <Button href="#" size="lg" icon="none">
        <Fragment slot="icon-left">
          <Icon name="tel" aria-hidden />
        </Fragment>
        お電話で相談する
      </Button>
      <Button href="#" variant="secondary" size="lg" icon="none">
        <Fragment slot="icon-left">
          <Icon name="mail" aria-hidden />
        </Fragment>
        お問い合わせフォーム
      </Button>
    </ButtonWrap>
    <div class="spButtons hide-up-md">
      <IconButton href="#" class="tel" variant="primary" shape="circle" aria-label="お電話で相談する">
        <Icon name="tel" aria-hidden />
      </IconButton>
      <IconButton href="#" class="mail" variant="secondary" shape="circle" aria-label="お問い合わせフォーム">
        <Icon name="mail" aria-hidden />
      </IconButton>
    </div>
  </NavigationMenu>
  {/* ハンバーガーメニューがオーバーレイの場合は、overlayをtrueにするか削除する */}
</header>

<style lang="scss">
  @use '@/styles/global' as *;
  @layer components {
    .GlobalHeader {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px;
      // NavigationMenuItem/HamburgerContentのtop propから anchor() で参照される
      anchor-name: --global-header;
      background: var(--color-white);
      &[data-sticky='true'] {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
      }

      :global(.Button) {
        min-height: auto;
      }
      :global(.Button[data-variant='secondary']) {
        background: #eb7800;
        box-shadow: 0 3px 0 0 #cc610d;
      }
      :global(.Button[data-variant='primary']) {
        background: #1b6fd9;
        box-shadow: 0 3px 0 0 #0f4a99;
      }
      // spanはButtonコンポーネント内の要素のため、:global() で囲まないとscopeが付いて当たらない
      :global(.Button[data-variant] span) {
        text-shadow: none;
      }
      .spButtons {
        display: flex;
        gap: 8px;
        .tel,
        .mail {
          --_icon-size: 20px;
          // IconButton側は height: auto のため、縦横比の違うmailアイコンも20×20の枠に収める
          :global(.Icon) {
            height: 20px;
          }
        }
        .tel {
          --_bg-color: #1b6fd9;
          --_color: var(--color-white);
          box-shadow: 0 3px 0 0 #0f4a99;
        }
        .mail {
          --_bg-color: #eb7800;
          --_color: var(--color-white);
          box-shadow: 0 3px 0 0 #cc610d;
        }
      }
      p {
        font-size: rem(13);
        color: #6b788c;
      }
    }
  }
</style>

<script>
  let headerObserver: ResizeObserver | null = null;

  function cleanup() {
    if (headerObserver) {
      headerObserver.disconnect();
      headerObserver = null;
    }
  }
  function initialize() {
    cleanup();

    const header = document.querySelector('header');
    if (!header) return;

    headerObserver = new ResizeObserver((entries) => {
      const entry = entries[0];
      if (entry?.borderBoxSize) {
        const blockSize = Math.round(entry.borderBoxSize[0].blockSize);
        document.documentElement.style.setProperty('--header-height', `${blockSize}px`);
      }
    });

    headerObserver.observe(header);
  }

  // ViewTransition不使用時
  initialize();

  // ViewTransition使用時
  // document.addEventListener('astro:after-swap', initialize);
</script>
