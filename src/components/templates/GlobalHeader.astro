---
import Accordion from '@/components/features/Accordion.astro';
import HamburgerButton from '@/components/features/hamburger/HamburgerButton.astro';
import HamburgerContent from '@/components/features/hamburger/HamburgerContent.astro';
import NavigationMenu from '@/components/features/NavigationMenu.astro';
import NavigationMenuItem from '@/components/features/NavigationMenuItem.astro';

export interface Props {
  current?: string;
  sticky?: boolean;
}

const { current, sticky = false } = Astro.props;
---

<header class="GlobalHeader" data-sticky={sticky}>
  <div class="logo">ロゴ</div>
  <NavigationMenu class="hide-down-md" aria-label="メインメニュー">
    <NavigationMenuItem href="/" aria-current={current === 'top' && true}>Home</NavigationMenuItem>
    <NavigationMenuItem href="/demo/" aria-current={current === 'demo' && true}>Demo</NavigationMenuItem>
    <NavigationMenuItem label="展開メニューauto" width="auto" id="nav-test-auto">
      <li><a href="/demo/">項目 A</a></li>
      <li><a href="/demo/">項目 B</a></li>
      <li><a href="/demo/">項目 C</a></li>
    </NavigationMenuItem>
    <NavigationMenuItem label="展開メニューfull" width="full" top="anchor(--global-header bottom)" id="nav-test-full">
      <li><a href="/demo/">項目 A</a></li>
      <li><a href="/demo/">項目 B</a></li>
      <li><a href="/demo/">項目 C</a></li>
    </NavigationMenuItem>
  </NavigationMenu>
  {/* ハンバーガーメニューがオーバーレイの場合は、overlayをtrueにするか削除する */}
  <HamburgerButton class="hide-up-md" target="HamburgerContent" overlay={false} />
  <HamburgerContent class="hide-up-md" id="HamburgerContent" overlay={false} top="anchor(--global-header bottom)">
    <ul>
      <li><a href="/" aria-current={current === 'top' && true}>Home</a></li>
      <li><a href="/demo/" aria-current={current === 'demo' && true}>Demo</a></li>
      <li>
        <Accordion>
          <Fragment slot="summary">展開するメニュー</Fragment>
          <ul>
            <li><a href="/demo/">項目 A</a></li>
            <li><a href="/demo/">項目 B</a></li>
            <li><a href="/demo/">項目 C</a></li>
          </ul>
        </Accordion>
      </li>
    </ul>
  </HamburgerContent>
</header>

<style lang="scss">
  @use '@/styles/global' as *;
  @layer components {
    .GlobalHeader {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: var(--spacing-md);
      // NavigationMenuItem/HamburgerContentのtop propから anchor() で参照される
      anchor-name: --global-header;
      background: #eee;
      &[data-sticky='true'] {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
      }
    }
  }
</style>

<script>
  let headerObserver: ResizeObserver | null = null;

  function cleanup() {
    if (headerObserver) {
      headerObserver.disconnect();
      headerObserver = null;
    }
  }
  function initialize() {
    cleanup();

    const header = document.querySelector('header');
    if (!header) return;

    headerObserver = new ResizeObserver((entries) => {
      const entry = entries[0];
      if (entry?.borderBoxSize) {
        const blockSize = Math.round(entry.borderBoxSize[0].blockSize);
        document.documentElement.style.setProperty('--header-height', `${blockSize}px`);
      }
    });

    headerObserver.observe(header);
  }

  // ViewTransition不使用時
  initialize();

  // ViewTransition使用時
  // document.addEventListener('astro:after-swap', initialize);
</script>
