---
import { Image, Picture } from 'astro:assets';
import List from '@/components/base/List.astro';
import Annotation from '../base/Annotation.astro';
import Logo from '@/images/footer_logo.svg';
---

<footer class="GlobalFooter">
  <div class="GlobalFooter__notice">
    <Annotation mark="※1">基本パック38,500円（税抜）について</Annotation>
    <List tag="ul" type="disc">
      <li>金額は、一般戸建住宅が対象で屋外は、外枡10枡以下。</li>
      <li>室内はキッチン、洗面台、浴室、洗濯排水の4箇所が基本となります。</li>
      <li>現場状況にて作業内容は異なる場合があり、別の個所などに変更となる場合があります。</li>
      <li>トイレ屋内高圧洗浄については、追加オプションです。</li>
      <li>追加箇所やキッチン排水トラップがS管の場合には追加料金が発生します。</li>
      <li>集合住宅の場合は、別途お見積もりをさせていただきます。</li>
    </List>
  </div>
  <div>
    <a href="/"> <Logo aria-label="ロゴ：ニチガス" /></a>
  </div>
  <nav>
    <ul>
      <li><a href="/corporate/aboutus">会社概要</a></li>
      <li><a href="/privacy">個人情報保護方針</a></li>
      <li><a href="/guide">サイトご利用にあたって</a></li>
      <li><a href="#contact">お問い合わせ</a></li>
    </ul>
  </nav>
  <div class="copyright">
    <small>© NIPPON GAS CO., LTD. All Rights Reserved.</small>
  </div>
</footer>

<style lang="scss">
  @use '@/styles/global' as *;
  @layer components {
    .GlobalFooter {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 72px 40px 48px;
      margin-top: 40px;
      background: #213354;
      @include mq-down(md) {
        padding: 36px 20px 24px;
      }
      &::before {
        position: absolute;
        top: -40px;
        left: 0;
        width: 100%;
        height: 40px;
        content: '';
        background-color: var(--color-bg-orange);
        background-image: url('@/images/footer_line.png');
        background-size: cover;
      }
      nav {
        margin-block: 32px;
        @include mq-down(md) {
          margin-block: 16px;
        }
        ul {
          display: flex;
          gap: 32px;
          @include mq-down(md) {
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
          }
          a {
            font-size: rem(14);
            font-weight: bold;
            color: var(--color-white);
            text-decoration: none;
            @include hover {
              text-decoration: underline;
            }
            @include mq-down(md) {
              font-size: rem(12);
            }
          }
        }
      }

      .copyright {
        font-size: rem(12);
        font-weight: bold;
        color: var(--color-white);
        text-align: center;
      }
      &__notice {
        margin-bottom: 72px;
        font-size: rem(14);
        color: var(--color-white);
        @include mq-down(md) {
          margin-bottom: 56px;
        }
        :global(.Annotation) {
          font-size: rem(14);
          color: var(--color-white);
        }
      }
    }
  }
</style>
