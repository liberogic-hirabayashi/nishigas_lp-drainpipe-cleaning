---
import { Image, Picture } from 'astro:assets';
import Logo from '@/images/footer_logo.svg';
---

<footer class="GlobalFooter">
  <div>
    <a href="/"> <Logo aria-label="ロゴ：ニチガス" /></a>
  </div>
  <nav>
    <ul>
      <li><a href="/corporate/aboutus">会社概要</a></li>
      <li><a href="/privacy">個人情報保護方針</a></li>
      <li><a href="/guide">サイトご利用にあたって</a></li>
      <li><a href="#contact">お問い合わせ</a></li>
    </ul>
  </nav>
  <div class="copyright">
    <small>© NIPPON GAS CO., LTD. All Rights Reserved.</small>
  </div>
</footer>

<style lang="scss">
  @use '@/styles/global' as *;
  @layer components {
    .GlobalFooter {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 80px 40px 48px;
      margin-top: 40px;
      background: #213354;
      @include mq-down(md) {
        padding: 36px 20px 24px;
      }
      &::before {
        position: absolute;
        top: -40px;
        left: 0;
        width: 100%;
        height: 40px;
        content: '';
        background-color: var(--color-bg-orange);
        background-image: url('@/images/footer_line.png');
        background-size: cover;
      }
      nav {
        margin-block: 32px;
        @include mq-down(md) {
          margin-block: 16px;
        }
        ul {
          display: flex;
          gap: 32px;
          @include mq-down(md) {
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
          }
          a {
            font-size: rem(14);
            font-weight: bold;
            color: var(--color-white);
            text-decoration: none;
            @include hover {
              text-decoration: underline;
            }
            @include mq-down(md) {
              font-size: rem(12);
            }
          }
        }
      }

      .copyright {
        font-size: rem(12);
        font-weight: bold;
        color: var(--color-white);
        text-align: center;
      }
    }
  }
</style>
