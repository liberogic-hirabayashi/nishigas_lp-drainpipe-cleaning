---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  justify?: 'start' | 'center' | 'end';
}

const { justify = 'center', class: className, ...rest } = Astro.props;
---

<div class:list={['ButtonWrap', className]} data-justify={justify} {...rest}>
  <slot />
</div>

<style lang="scss">
  @use '@/styles/global' as *;
  @layer components {
    .ButtonWrap {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-md);
      justify-content: center;
      &[data-justify='start'] {
        justify-content: flex-start;
      }
      &[data-justify='end'] {
        justify-content: flex-end;
      }
    }
  }
</style>
