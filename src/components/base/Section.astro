---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'section'> {
  tag?: 'section' | 'div';
  bg?: 'yellow' | 'blue';
}

const { tag = 'section', bg, class: className, ...rest } = Astro.props;

const Tag = tag;
---

<Tag class:list={['Section', className]} data-bg={bg} {...rest}><slot /></Tag>

<style lang="scss">
  @use '@/styles/global' as *;
  @layer components {
    .Section {
      position: relative;
      padding-block: var(--spacing-3xl);
      @include mq-down(md) {
        padding-bottom: var(--spacing-lg);
      }
      &:last-of-type {
        padding-bottom: var(--spacing-3xl);
      }
      &::before {
        position: absolute;
        top: -40px;
        left: 0;
        width: 100%;
        height: 40px;
        content: '';
        background-image: url('@/images/sec_line.png');
        background-size: cover;
      }
      &[data-bg] {
        position: relative;
        padding-block: var(--spacing-3xl);
        background: var(--color-bg-section);
        @include mq-down(md) {
          padding-block: var(--spacing-xl);
        }
        &:not(:first-of-type) {
          &::before {
            position: absolute;
            top: -40px;
            left: 0;
            width: 100%;
            height: 40px;
            content: '';
            // background-image: url('@/images/sec_line.png');
            background-size: cover;
          }
        }
      }
      &[data-bg='yellow'] {
        background: var(--color-bg-orange);
        &::before {
          background-image: url('@/images/sec_line_yellow.png');
        }
      }
      &[data-bg='blue'] {
        background: var(--color-bg-blue);
        &::before {
          background-image: url('@/images/sec_line_blue.png');
        }
      }
      &:not([data-bg]) + [data-bg] {
        // margin-top: var(--spacing-3xl);
      }
      // ブレイクアウトを使う子孫（data-breakout="true"）がいる場合だけコンテナにする
      &:has([data-breakout='true']) {
        container-type: inline-size;
      }
    }
  }
</style>
