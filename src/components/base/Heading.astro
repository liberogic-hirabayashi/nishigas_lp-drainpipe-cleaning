      font-weight: bold;
      line-height: 1.4;
      > a {
        color: inherit;
        @include hover {
          text-decoration: none;
        }
      }
    }
    .h3 {
      margin-block: var(--leading-trim) calc(var(--leading-trim) + 1em);
