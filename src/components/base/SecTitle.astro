---
export interface Props {
  tag?: string;
}
const { tag } = Astro.props;
---

<div class="SecTitle">
  <span class=`SecTitle__tag`>{tag}</span>
  <div>
    <slot />
  </div>
</div>

<style lang="scss">
  @use '@/styles/global' as *;
  .SecTitle {
    max-width: 960px;
    margin-inline: auto;
    margin-bottom: 40px;
    text-align: center;
    @include mq-down(md) {
      margin-bottom: 24px;
    }
    &__tag {
      padding: 6px 16px;
      font-size: rem(13);
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.1rem;
      background-color: var(--color-yellow);
      border-radius: var(--rounded-full);
    }
    > div {
      :global(.h2) {
        margin-block: 16px;
        font-size: rem(40);
        line-height: 1.5;
        @include mq-down(md) {
          font-size: rem(21);
        }
      }
      :global(span:not(.mark)) {
        color: var(--color-primary);

        &.-orange {
          color: var(--color-secondary);
        }
        &.-red {
          color: #e55454;
        }
      }
    }
  }
</style>
